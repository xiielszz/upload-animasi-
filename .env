# WAJIB diisi supaya panel Admin (tab Admin -> buat/hapus Access Key) bisa dipakai.
# Ini password admin kamu sendiri -- jangan dibagikan ke user biasa.
ADMIN_SECRET=Ntuyxd567@#

# Semua di bawah ini OPSIONAL — cuma fallback kalau field API Key / User ID
# di website (tersimpan per-browser lewat localStorage) masih kosong.
# Untuk pemakaian normal, isi langsung lewat website-nya
# (tab Upload Animasi/Audio -> Pengaturan Akun Roblox).

# Buat API key di https://create.roblox.com/dashboard/credentials
# (permission: Assets API -> Create + Read)
ROBLOX_API_

# userId default kalau tidak diisi lewat form
ROBLOX_CREATOR_ID=10800823608

# Opsional: path folder untuk menyimpan data/keys.json (daftar Access Key).
# Kalau deploy di Railway dan mau data ini tidak hilang saat redeploy,
# attach Railway Volume, mount ke path ini (mis. /data), lalu isi:
# DATA_DIR=/data
